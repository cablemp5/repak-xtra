+        /// <summary>
+        /// repakxtra: typed getters and setters for the members every property element carries (a Niagara system holds
+        /// tens of thousands of byte elements, each with about ten of them). Newtonsoft reaches members through
+        /// reflection under NativeAOT, which made writing them most of a decode. Same members, same values, same order.
+        /// </summary>
+        private interface IFieldBacked { System.Reflection.FieldInfo Field { set; } }
+
+        private sealed class Member<TObj, TVal> : IValueProvider, IFieldBacked
+        {
+            private readonly Func<TObj, TVal> get;
+            private readonly Action<TObj, TVal> set;
+            public System.Reflection.FieldInfo Field { private get; set; }
+            public Member(Func<TObj, TVal> get, Action<TObj, TVal> set) { this.get = get; this.set = set; }
+            public object GetValue(object target) => get((TObj)target);
+            // anything but the field's own type (a converter's boxed int 0 for a float, a null) goes through reflection as
+            // before, with its conversions
+            public void SetValue(object target, object value)
+            {
+                if (value is TVal v) set((TObj)target, v);
+                else Field.SetValue(target, value);
+            }
+        }
+
+        private static IValueProvider FastMember(System.Reflection.MemberInfo member)
+        {
+            var provider = FastMemberFor(member);
+            if (provider is IFieldBacked backed) backed.Field = (System.Reflection.FieldInfo)member;
+            return provider;
+        }
+
+        private static IValueProvider FastMemberFor(System.Reflection.MemberInfo member)
+        {
+            if (member is not System.Reflection.FieldInfo) return null;
+            if (member.DeclaringType == typeof(PropertyData))
+            {
+                switch (member.Name)
+                {
+                    case nameof(PropertyData.Name): return new Member<PropertyData, FName>(o => o.Name, (o, v) => o.Name = v);
+                    case nameof(PropertyData.ArrayIndex): return new Member<PropertyData, int>(o => o.ArrayIndex, (o, v) => o.ArrayIndex = v);
+                    case nameof(PropertyData.IsZero): return new Member<PropertyData, bool>(o => o.IsZero, (o, v) => o.IsZero = v);
+                    case nameof(PropertyData.PropertyTagFlags): return new Member<PropertyData, EPropertyTagFlags>(o => o.PropertyTagFlags, (o, v) => o.PropertyTagFlags = v);
+                    case nameof(PropertyData.PropertyTagExtensions): return new Member<PropertyData, EPropertyTagExtension>(o => o.PropertyTagExtensions, (o, v) => o.PropertyTagExtensions = v);
+                    case nameof(PropertyData.OverrideOperation): return new Member<PropertyData, EOverriddenPropertyOperation>(o => o.OverrideOperation, (o, v) => o.OverrideOperation = v);
+                    case nameof(PropertyData.bExperimentalOverridableLogic): return new Member<PropertyData, bool>(o => o.bExperimentalOverridableLogic, (o, v) => o.bExperimentalOverridableLogic = v);
+                }
+            }
+            else if (member.DeclaringType == typeof(BytePropertyData))
+            {
+                switch (member.Name)
+                {
+                    case nameof(BytePropertyData.ByteType): return new Member<BytePropertyData, BytePropertyType>(o => o.ByteType, (o, v) => o.ByteType = v);
+                    case nameof(BytePropertyData.EnumType): return new Member<BytePropertyData, FName>(o => o.EnumType, (o, v) => o.EnumType = v);
+                    case nameof(BytePropertyData.Value): return new Member<BytePropertyData, byte>(o => o.Value, (o, v) => o.Value = v);
+                    case nameof(BytePropertyData.EnumValue): return new Member<BytePropertyData, FName>(o => o.EnumValue, (o, v) => o.EnumValue = v);
+                }
+            }
+            else if (member.DeclaringType == typeof(FloatPropertyData) && member.Name == nameof(FloatPropertyData.Value))
+            {
+                return new Member<FloatPropertyData, float>(o => o.Value, (o, v) => o.Value = v);
+            }
+            return null;
+        }
+
+        protected override JsonProperty CreateProperty(System.Reflection.MemberInfo member, MemberSerialization memberSerialization)
+        {
+            JsonProperty property = base.CreateProperty(member, memberSerialization);
+            if (FastMember(member) is IValueProvider fast) property.ValueProvider = fast;
+            // the ShouldSerialize<Member> methods the base found by reflection, called directly
+            if (property.ShouldSerialize != null && member.DeclaringType == typeof(BytePropertyData))
+            {
+                if (member.Name == nameof(BytePropertyData.Value)) property.ShouldSerialize = o => ((BytePropertyData)o).ShouldSerializeValue();
+                else if (member.Name == nameof(BytePropertyData.EnumValue)) property.ShouldSerialize = o => ((BytePropertyData)o).ShouldSerializeEnumValue();
+            }
+            else if (property.ShouldSerialize != null && member.DeclaringType == typeof(PropertyData))
+            {
+                if (member.Name == nameof(PropertyData.OverrideOperation)) property.ShouldSerialize = o => ((PropertyData)o).ShouldSerializeOverrideOperation();
+                else if (member.Name == nameof(PropertyData.bExperimentalOverridableLogic)) property.ShouldSerialize = o => ((PropertyData)o).ShouldSerializebExperimentalOverridableLogic();
+            }
+            return property;
+        }
+
