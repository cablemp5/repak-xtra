+    // A stripped directory keeps hashes of real game paths. Match those paths, never infer names from mod titles.
+    private void RecoverPaths(Dictionary<ulong, uint> hashes, byte[] encodedEntries)
+    {
+        if (_stream is not FileStream file)
+            throw new InvalidDataException("This PAK needs the game's filenames to read its stripped directory.");
+        var paks = new DirectoryInfo(Path.GetDirectoryName(file.Name)!);
+        while (paks != null && !paks.Name.Equals("Paks", StringComparison.OrdinalIgnoreCase))
+            paks = paks.Parent;
+        if (paks == null)
+            throw new InvalidDataException("This PAK has no filename directory. Read it from the game's Paks folder.");
+
+        var remaining = hashes.Where(h => (h.Value & 0x80000000u) == 0).ToDictionary(h => h.Key, h => h.Value);
+        foreach (string candidate in Directory.EnumerateFiles(paks.FullName, "*.pak").OrderBy(p => p, StringComparer.OrdinalIgnoreCase))
+        {
+            if (remaining.Count == 0) break;
+            if (Path.GetFullPath(candidate).Equals(Path.GetFullPath(file.Name), StringComparison.OrdinalIgnoreCase)) continue;
+            using var game = new PakReader(candidate, Convert.ToHexString(_standardAesKey), recoverPaths: false);
+            foreach (string name in game.Files)
+            {
+                string full = game.MountPoint.TrimEnd('/') + "/" + name.TrimStart('/');
+                if (!full.StartsWith(MountPoint, StringComparison.OrdinalIgnoreCase)) continue;
+                string relative = full[MountPoint.Length..];
+                ulong hash = PakWriter.Fnv64Path(relative, PathHashSeed);
+                if (!remaining.Remove(hash, out uint offset)) continue;
+                _entries[relative] = ParseEncodedEntry(encodedEntries, checked((int)offset));
+            }
+        }
+        if (remaining.Count > 0 || _entries.Count == 0)
+            throw new InvalidDataException("Some filenames in this PAK's stripped directory could not be matched to the installed game.");
+    }
