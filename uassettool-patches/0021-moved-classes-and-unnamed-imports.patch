index d68ee87..1d8a0c1 100644
--- a/src/UAssetTool/ZenPackage/ScriptObjectsDatabase.cs
+++ b/src/UAssetTool/ZenPackage/ScriptObjectsDatabase.cs
@@ -289,6 +289,52 @@ public class ScriptObjectsDatabase
         return null;
     }
     
+    // repakxtra: a script object a game update moved to another /Script package (Season 11 took
+    // AnimNotifyState_SetComponentsInActorVisible from /Script/Marvel to /Script/MarvelAnimNotify). A package cooked
+    // before the move imports the hash of the old path, which the game no longer has, and the game crashes on it. Its
+    // current place is the one object whose path hashes to that index once another script package's name stands in for
+    // its own. Null when the index is known as it is, when nothing matches, or when more than one object does. The
+    // answer is kept per index, a miss too: one search is every object under every package name.
+    private readonly System.Collections.Concurrent.ConcurrentDictionary<ulong, ScriptObjectEntry?> _moved = new();
+
+    public ScriptObjectEntry? GetMoved(FPackageObjectIndex index)
+    {
+        if (index.IsNull() || !index.IsScriptImport() || _scriptObjectsByIndex.ContainsKey(index.Value))
+            return null;
+        return _moved.GetOrAdd(index.Value, FindMoved);
+    }
+
+    private ScriptObjectEntry? FindMoved(ulong missing)
+    {
+        const string Script = "/Script/";
+        static byte[] Utf16(string s) => System.Text.Encoding.Unicode.GetBytes(s.Replace(':', '/').Replace('.', '/').ToLowerInvariant());
+        // "/Script/<Package>" names, and every object under one as ("/<rest of its path>", its index)
+        var packages = new List<byte[]>();
+        var objects = new List<(byte[] Tail, ulong Index)>();
+        foreach (var (path, index) in _scriptObjectsByName)
+        {
+            if (!path.StartsWith(Script, StringComparison.OrdinalIgnoreCase)) continue;
+            int slash = path.IndexOf('/', Script.Length);
+            if (slash < 0) packages.Add(Utf16(path));
+            else objects.Add((Utf16(path.Substring(slash)), index));
+        }
+        ulong want = missing & ~(3ul << 62);
+        var found = new System.Collections.Concurrent.ConcurrentDictionary<ulong, bool>();
+        System.Threading.Tasks.Parallel.ForEach(packages, package =>
+        {
+            var buffer = new byte[package.Length + 1024];
+            Buffer.BlockCopy(package, 0, buffer, 0, package.Length);
+            foreach (var (rest, index) in objects)
+            {
+                if (rest.Length > 1024) continue;
+                Buffer.BlockCopy(rest, 0, buffer, package.Length, rest.Length);
+                if ((IoStore.CityHash.CityHash64(buffer, 0, package.Length + rest.Length) & ~(3ul << 62)) == want)
+                    found[index] = true;
+            }
+        });
+        return found.Count == 1 && _scriptObjectsByIndex.TryGetValue(System.Linq.Enumerable.First(found.Keys), out var entry) ? entry : null;
+    }
