+    // repakxtra: what a package's class references say about loading it in this game. "damaged": an export without a
+    // class (a repack that lost it, the game crashes on it). "moved": a script import the game has under another script
+    // package (ScriptObjectsDatabase.GetMoved), which an extract reads at its current place. Null when neither, or the
+    // header cannot be read.
+    private static string? ReadClassMark(
+        IoStore.IoStoreReader reader, IoStore.FIoChunkId exportChunk, ZenPackage.ScriptObjectsDatabase? scriptObjects)
+    {
+        if (scriptObjects == null) return null;
+        try
+        {
+            byte[] header = reader.ReadChunkPrefix(exportChunk, 64 * 1024);
+            for (int pass = 0; pass < 2; pass++)
+            {
+                using var ms = new MemoryStream(header);
+                using var br = new BinaryReader(ms);
+                var summary = new ZenPackage.FZenPackageSummary();
+                summary.Read(br, ZenPackage.EIoContainerHeaderVersion.NoExportInfo);
+                int start = summary.ImportMapOffset, end = summary.ExportMapOffset;
+                if (start <= 0 || end < start) return null;
+                var exports = end <= header.Length
+                    ? ZenPackage.FZenPackageHeader.ReadExportMapOnly(header, ZenPackage.EIoContainerHeaderVersion.NoExportInfo) : null;
+                if (exports == null)
+                {
+                    // the header did not fit in the prefix: the whole chunk, once
+                    if (pass == 0 && reader.GetChunkSize(exportChunk) > header.Length) { header = reader.ReadChunk(exportChunk); continue; }
+                    return null;
+                }
+                if (exports.Any(e => e.ClassIndex.IsNull())) return "damaged";
+                // one the game has under another script package: as an export's class, parent or template, or in the
+                // import map. One the game lacks altogether says nothing: its own files keep some (6 packages of
+                // 267,106 in Character, 2026-11-14) and load
+                bool moved(ZenPackage.FPackageObjectIndex i) => i.IsScriptImport() && scriptObjects.GetScriptObject(i) == null && scriptObjects.GetMoved(i) != null;
+                if (exports.Any(e => moved(e.ClassIndex) || moved(e.SuperIndex) || moved(e.TemplateIndex))) return "moved";
+                for (int at = start; at + 8 <= end; at += 8)
+                    if (moved(new ZenPackage.FPackageObjectIndex(BitConverter.ToUInt64(header, at)))) return "moved";
+                return null;
+            }
+        }
+        catch (Exception ex)
+        {
+            if (Environment.GetEnvironmentVariable("DEBUG") == "1")
+                Console.Error.WriteLine($"[ReadClassMark] {ex.GetType().Name}: {ex.Message}");
+        }
+        return null;
+    }
+
