+++ b/src/UAssetAPI/AssetBinaryReader.cs
@@ -19,6 +19,30 @@ namespace UAssetAPI
 
         }
 
+        /// <summary>
+        /// BinaryReader allocates the whole count before reading what is left, so a misread length asks for gigabytes.
+        /// Asks only for what is left: the same bytes come back.
+        /// </summary>
+        public override byte[] ReadBytes(int count)
+        {
+            if (count > 0 && BaseStream.CanSeek)
+            {
+                long left = BaseStream.Length - BaseStream.Position;
+                if (count > left) count = (int)Math.Max(left, 0);
+            }
+            return base.ReadBytes(count);
+        }
+
+        /// <summary>
+        /// Throws when <paramref name="count"/> items of at least <paramref name="minBytes"/> each cannot fit in what is
+        /// left of the stream: reading them would fail anyway, after allocating an array that size.
+        /// </summary>
+        public void EnsureFits(int count, int minBytes)
+        {
+            if (count < 0 || (BaseStream.CanSeek && (long)count * minBytes > BaseStream.Length - BaseStream.Position))
+                throw new EndOfStreamException($"{count} items do not fit in the {BaseStream.Length - BaseStream.Position} bytes left");
+        }
+
         protected byte[] ReverseIfBigEndian(byte[] data)
         {
