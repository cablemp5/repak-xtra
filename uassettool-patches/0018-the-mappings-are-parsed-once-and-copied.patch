--- a/src/UAssetAPI/Unversioned/Usmap.cs
+++ b/src/UAssetAPI/Unversioned/Usmap.cs
@@ -778,6 +778,41 @@
             return string.Join("\n", res.ToArray());
         }
 
+        // repakxtra: the mappings file parsed once and handed out as copies. Every tool call parsed it again (about
+        // 0.8 s each, four times in a mod update). A copy has its own name, enum, and schema tables, because reading an
+        // asset adds what it learns to them, so a call never sees what an earlier call learned and its output is the
+        // same as with a fresh parse. The parsed schemas themselves are never changed after the read. The parse is
+        // let go 60 s after its last use, and read again when the file changes
+        private static readonly object SharedLock = new object();
+        private static string SharedKey;
+        private static Usmap SharedParse;
+        private static System.Threading.Timer SharedDrop;
+
+        public static Usmap Shared(string path)
+        {
+            var info = new FileInfo(path);
+            string key = info.FullName + "|" + info.Length + "|" + info.LastWriteTimeUtc.Ticks;
+            Usmap parse;
+            lock (SharedLock)
+            {
+                if (SharedKey != key) { SharedParse = new Usmap(path); SharedKey = key; }
+                parse = SharedParse;
+                SharedDrop ??= new System.Threading.Timer(_ => { lock (SharedLock) { SharedKey = null; SharedParse = null; } });
+                SharedDrop.Change(60000, System.Threading.Timeout.Infinite);
+            }
+            var names = parse.AreFNamesCaseInsensitive ? StringComparer.InvariantCultureIgnoreCase : StringComparer.InvariantCulture;
+            var copy = (Usmap)parse.MemberwiseClone();
+            copy.FilePath = path;
+            copy.NameMap = new List<string>(parse.NameMap);
+            copy.EnumMap = new ConcurrentDictionary<string, UsmapEnum>(parse.EnumMap, names);
+            copy.Schemas = new ConcurrentDictionary<string, UsmapSchema>(parse.Schemas, names);
+            if (parse.FailedExtensions != null) copy.FailedExtensions = new List<string>(parse.FailedExtensions);
+            // (each entry copied too: reading an asset that lacks one marks the entry itself as not serialized)
+            if (parse.CustomVersionContainer != null) copy.CustomVersionContainer = parse.CustomVersionContainer.ConvertAll(v => (CustomVersion)v.Clone());
+            copy.PathsAlreadyProcessedForSchemas = new ConcurrentDictionary<string, byte>();
+            return copy;
+        }
+
         // not a set to ensure thread safety
         public ConcurrentDictionary<string, byte> PathsAlreadyProcessedForSchemas = new ConcurrentDictionary<string, byte>();
         public UsmapSchema GetSchemaFromName(string nm, UAsset asset = null, string modulePath = null, bool throwExceptions = true)
