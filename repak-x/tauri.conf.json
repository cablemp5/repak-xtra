{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "RepakX",
  "version": "2.2.0",
  "identifier": "com.cablemp5.repakxtra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/RepakIcon.ico",
      "icons/RepakIcon.png"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "repakxtra",
        "width": 1400,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.githubusercontent.com https://github.com https://i.imgur.com https://cdn.discordapp.com",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://api.github.com https://discord.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "repakx"
        ]
      }
    }
  }
}